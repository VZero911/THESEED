","nameLocation":"2224:10:52","parameters":{"id":47243,"nodeType":"ParameterList","parameters":[],"src":"2234:2:52"},"returnParameters":{"id":47246,"nodeType":"ParameterList","parameters":[{"constant":false,"id":47245,"mutability":"mutable","name":"","nameLocation":"-1:-1:-1","nodeType":"VariableDeclaration","scope":47250,"src":"2268:7:52","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"},"typeName":{"id":47244,"name":"address","nodeType":"ElementaryTypeName","src":"2268:7:52","stateMutability":"nonpayable","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"}},"visibility":"internal"}],"src":"2267:9:52"},"scope":47251,"stateMutability":"view","virtual":true,"visibility":"internal"}],"abstract":false,"baseContracts":[{"baseName":{"id":47203,"name":"Proxy","nameLocations":["1140:5:52"],"nodeType":"IdentifierPath","referencedDeclaration":47193,"src":"1140:5:52"},"id":47204,"nodeType":"InheritanceSpecifier","src":"1140:5:52"}],"canonicalName":"BeaconProxy","contractDependencies":[],"contractKind":"contract","documentation":{"id":47202,"nodeType":"StructuredDocumentation","src":"272:843:52","text":" @dev This contract implements a proxy that gets the implementation address for each call from an {UpgradeableBeacon}.\n The beacon address can only be set once during construction, and cannot be changed afterwards. It is stored in an\n immutable variable to avoid unnecessary storage reads, and also in the beacon storage slot specified by\n https://eips.ethereum.org/EIPS/eip-1967[ERC-1967] so that it can be accessed externally.\n CAUTION: Since the beacon address can never be changed, you must ensure that you either control the beacon, or trust\n the beacon to not upgrade the implementation maliciously.\n IMPORTANT: Do not use the implementation logic to modify the beacon storage slot. Doing so would leave the proxy in\n an inconsistent state where the beacon storage slot does not match the beacon address."},"fullyImplemented":true,"linearizedBaseContracts":[47251,47193],"name":"BeaconProxy","nameLocation":"1125:11:52","scope":47252,"usedErrors":[46883,46893,46896,49278,52153],"usedEvents":[46540]}],"license":"MIT"},"id":52}